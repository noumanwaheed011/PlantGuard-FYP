# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1

# JWT Secret Key (generate a strong random key)
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB_NAME=plantguard_db

# Email Configuration (Gmail example)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=PlantGuard AI

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=5000

# CORS — include local Vite + your Vercel frontend URL (comma-separated, no spaces)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-app.vercel.app

# Default admin account (created automatically on first startup if missing)
ADMIN_EMAIL=admin@plantguard.ai
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Admin

# Production notes:
# - Use MongoDB Atlas URI (not localhost) when deploying to Render
# - Example: MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# - Set FLASK_DEBUG=0 and FLASK_ENV=production on Render
